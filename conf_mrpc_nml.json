    "hidden_dim":512,
    "n_epoch":15,
    "lr":1e-3,
    "metric":"f1_score",
    "loss":"loss_fn_sim_par",
    "dropout":0.2,
    "n_lut":8,
    "mlp_factor":0.5

}
